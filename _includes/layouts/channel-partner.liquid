{% include 'parts/header.liquid' %}



<!-- Title Banner Section -->
{% include 'sections/title-banner.liquid' %}
<!-- End: Title Banner Section -->



<style>
.channel-benefits-section .channel-benefits {
	display: inline-grid;
	gap: var(--space-100);
	grid-template-columns: repeat(1, 1fr);
}
.channel-benefits-section .benefits {
	display: grid;
	gap: var(--space-50);
	grid-template-columns: repeat(1, 1fr);
}
@media( min-width: 500px ) { .channel-benefits-section .benefits { grid-template-columns: repeat(2, 1fr); } }
@media( min-width: 1000px ) {
	.channel-benefits-section .channel-benefits { grid-template-columns: repeat(3, 1fr); }
	.channel-benefits-section .benefits {
		text-align: left;
		grid-column: span 2;
	}
}

.channel-benefits-section .thumbnail { position: relative; }
.channel-benefits-section .thumbnail img { position: relative; z-index: 1; }
