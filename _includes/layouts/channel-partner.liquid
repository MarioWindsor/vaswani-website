<!-- Channel Intro Section -->
<section id="channel-intro-section" class="channel-intro-section gap">
	<div class="row">
		<div class="container">
			<div class="title columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 xlarge-6 xlarge-offset-3 text-center">
				<label class="section-label">{{ intro.label }}</label>
				<h2 class="section-heading text-neutral-20 w-600">{{ intro.heading }}</h2>
				<h6 class="section-sub-heading text-primary space-25-vertical">{{ intro.sub-heading }}</h6>
				<p class="description space-25-top">{{ intro.description }}</p>
			</div>
		</div>
	</div>
</section>
<!-- End: Channel Intro Section -->



<!-- Channel Partner Benefits Section -->
<section class="channel-benefits-section row small-gap">
	<div class="container">
		<div class="row">
			<div class="columns small-12 text-center space-50-bottom">
				<label class="section-label">{{ benefits.label }}</label>
			</div>
			<div class="channel-benefits columns small-12 text-center">
				<div class="thumbnail">
					<img loading="lazy" class="block radius-25 box-shadow" src="{{ benefits.image }}" alt="">
					<!-- <img loading="lazy" class="dotmatrix" src="media/dot-matrix-large-green-tall.svg" alt=""> -->
				</div>
				<div class="row benefits">
					{% for benefit in benefits.list %}
					<div class="benefit card space-50">
						<h5 class="text-neutral-50">{{ benefit.title }}</h5>
						<p class="space-25-top">{{ benefit.description }}</p>
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>
<!-- End: Channel Partner Benefits Section -->



<!-- Channel CTA Section -->
<section id="channel-cta-section" class="channel-cta-section small-gap fill-dark space-100-vertical">
	<div class="row">
		<div class="container">
			<div class="columns small-12 medium-10 large-8 xlarge-6 medium-offset-1 large-offset-2 xlarge-offset-3 text-center">
				<label class="section-label">{{ cta.label }}</label>
				<a class="button w-500" href="mailto: {{ cta.email }}" style="text-transform: none;">{{ cta.email }}</a>
				<p class="space-50-top">{{ cta.description }}</p>
			</div>
		</div>
	</div>
</section>
<!-- End: Channel CTA Section -->




