{% include 'parts/header.liquid' %}



<!-- Title Banner Section -->
{% include 'sections/title-banner.liquid' %}
<!-- End: Title Banner Section -->



<style>
	.careers-section .thumbnail { position: relative; }
	.careers-section .thumbnail img { position: relative; z-index: 1; }
	.careers-section .thumbnail .dotmatrix { display: none; }

	.careers-section .opportunities {
		display: inline-grid;
		gap: var(--space-100);
		grid-template-columns: repeat(1, 1fr);
	}

	.careers-section .careers {
		display: grid;
		gap: var(--space-50);
		grid-template-columns: repeat(1, 1fr);
	}
	.careers-section .careers .career {

	}
	@media( min-width: 500px ) {
		.careers-section .careers {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	@media( min-width: 1000px ) {
		.careers-section .opportunities {
			grid-template-columns: repeat(2, 1fr);
		}
		.careers-section .careers {
			text-align: left;
			grid-template-columns: repeat(1, 1fr);
		}

		.careers-section .thumbnail .dotmatrix {
					display: block;
					position: absolute;
					z-index: -1;
					bottom: 0;
					right: 100%;
					width: calc(var(--card)/1.5);
					opacity: 66.666%;
					transform: translate(50%, 0%);
				}
	}

</style>



<!-- Careers Intro Section -->
<section id="careers-intro-section" class="careers-intro-section gap">
	<div class="row">
		<div class="container">
			<div class="title columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 xlarge-6 xlarge-offset-3 text-center">
				<label class="section-label">Join Us</label>
				<h2 class="section-heading text-neutral-20 w-600">Our People are Our Strength</h2>
				<h6 class="section-sub-heading text-primary space-25-vertical">At our core, we are a family of visionaries and craftsmen.</h6>
				<p class="description space-25-top">We believe a company is only as strong as its team, nurturing a culture built on trust, respect, and collaboration — where every individual is valued and empowered to grow.</p>
			</div>
		</div>
	</div>
</section>
<!-- End: Careers Intro Section -->



<!-- Careers Cta Section -->
<section id="careers-cta-section" class="careers-cta-section small-gap fill-dark space-100-vertical">
	<div class="row">
		<div class="container">
			<div class="columns small-12 medium-10 large-8 xlarge-6 medium-offset-1 large-offset-2 xlarge-offset-3 text-center">
				<label class="section-label">send in your resume to</label>
				<a class="button w-500" href="mailto: careers@vaswanigroup.com" style="text-transform: none;">careers@vaswanigroup.com</a>
				<p class="space-50-top">We have a place for those who are passionate about their craft. Whether you're a seasoned professional or just starting your journey, explore how you can contribute to our vision.</p>
			</div>
		</div>
	</div>
</section>
<!-- End: Careers Cta Section -->



<!-- Careers Section -->
<section id="careers-section" class="careers-section row small-gap">
	<div class="row">
		<div class="container">
			<div class="columns small-12 text-center space-50-bottom">
				<label class="section-label">Explore Opportunities</label>
			</div>
			<div class="opportunities columns small-12 large-10 large-offset-1 xlarge-8 xlarge-offset-2 text-center">
				<div class="thumbnail">
					<img class="block radius-25 box-shadow" src="media/genai-careers.png" alt="">
					<img class="dotmatrix" src="media/dot-matrix-large-green.svg" alt="">
				</div>
				<div class="careers">
					<div class="career card space-50">
						<h5 class="text-neutral-50">Architects of Our Future</h5>
						<small class="block w-600 text-primary">Roles: Architects, Design Managers.</small>
						<p class="label space-25-top">For those who dream in blueprints and see beauty in detail. Come shape our award-winning designs and help us create spaces that inspire awe.</p>
					</div>
					<div class="career card space-50">
						<h5 class="text-neutral-50">Builders of Our Vision</h5>
						<small class="block w-600 text-primary">Roles: Project Managers, Engineers.</small>
						<p class="label space-25-top">If you’re passionate about bringing a vision to life, this is your path. Join us in the meticulous, day-to-day work of turning dreams into tangible reality.</p>
					</div>
					<div class="career card space-50">
						<h5 class="text-neutral-50">Voices of Our Brand</h5>
						<small class="block w-600 text-primary">Roles: Marketing Specialists, Sales Executives.</small>
						<p class="label space-25-top">For those who have a knack for storytelling. Help us share the magic of a Vaswani home with the world, connecting with people and helping them begin their journey.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- End: Careers Section -->



