<style>
.nri-reason-section .reasoning {
	display: inline-grid;
	gap: var(--space-100);
	grid-template-columns: repeat(1, 1fr);
}
.nri-reason-section .reasons {
	display: grid;
	gap: var(--space-50);
	grid-template-columns: repeat(1, 1fr);
}
@media( min-width: 500px ) { .nri-reason-section .reasons { grid-template-columns: repeat(3, 1fr); } }
@media( min-width: 1000px ) {
	.nri-reason-section .reasoning { grid-template-columns: repeat(2, 1fr); }
	.nri-reason-section .reasons {
		text-align: left;
		grid-template-columns: repeat(1, 1fr);
	}
}

.nri-steps-section .steps {
	display: inline-grid;
	gap: var(--space-50);
	grid-template-columns: repeat(1, 1fr);
}
.nri-steps-section .steps .step {
	display: inline-grid;
	gap: var(--space-50);
	grid-template-columns: repeat(1, 1fr);
}
@media( min-width: 500px ) { .nri-steps-section .steps { grid-template-columns: repeat(2, 1fr); } }
@media( min-width: 1000px ) { .nri-steps-section .steps .step { grid-template-columns: repeat(2, 1fr); } }
@media( min-width: 1500px ) {
	.nri-steps-section .steps { grid-template-columns: repeat(4, 1fr); }
	.nri-steps-section .steps .step { grid-template-columns: repeat(1, 1fr); }
}

.nri-reason-section .thumbnail { position: relative; }
.nri-reason-section .thumbnail img { position: relative; z-index: 1; }
.nri-reason-section .thumbnail .dotmatrix { display: none; }
@media( min-width: 1000px ) {
	.nri-reason-section .thumbnail .dotmatrix {
		display: block;
		position: absolute;
		z-index: -1;
		bottom: 0;
		right: 100%;
		width: calc(var(--card)/1.5);
		opacity: 66.666%;
		transform: translate(50%, 0%);
	}
}
</style>



<!-- NRI Intro Section -->
<section id="nri-section-intro" class="nri-section-intro gap">
	<div class="container">
		<div class="nri-intro row">
			<div class="title columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 xlarge-6 xlarge-offset-3 text-center">
				<label class="section-label">Anchor to India</label>
				<h2 class="section-heading text-neutral-20 w-600">A Legacy Across Continents</h2>
				<h6 class="section-sub-heading text-primary space-25-vertical">Live the Dream, Here at Home.</h6>
				<p class="description space-25-top">Crafted for a Global Citizen. Bangalore, the beating heart of India’s innovation, a global hub of opportunity. For our NRI Customers, we are the partner who understands their vision. Investing here is more than a financial decision — it’s a strategic move to build a legacy.</p>
			</div>
		</div>
	</div>
</section>
<!-- End: NRI Intro Section -->



<!-- NRI Reason Section -->
<section class="nri-reason-section row small-gap">
	<div class="container">
		<div class="row">
			<div class="columns small-12 text-center space-50-bottom">
				<label class="section-label">Why Invest in Bangalore?</label>
			</div>
			<div class="reasoning columns small-12 large-10 large-offset-1 xlarge-8 xlarge-offset-2 text-center">
				<div class="thumbnail">
					<img loading="lazy" class="block radius-25 box-shadow" src="media/genai-bangalore-realestate.png" alt="">
					<img loading="lazy" class="dotmatrix" src="media/dot-matrix-large-green.svg" alt="">
				</div>
				<div class="row reasons">
					<div class="reason card space-50">
						<h5 class="text-neutral-50">Capital Appreciation</h5>
						<p class="space-25-top">Bangalore’s ultra-luxury segment has seen a remarkable <span class="text-primary">59% sales increase</span> in the last financial year. This dynamic growth positions your investment for exceptional returns.</p>
					</div>
					<div class="reason card space-50">
						<h5 class="text-neutral-50">Lifestyle Upgrade</h5>
						<p class="space-25-top">The demand for spacious, high-quality living is paramount. With <span class="text-primary">60% of new real-estate development offering 3 & 4BHK Luxury Spaces</span>, buyers are seeking multi-functional spaces for work, wellness, and family life</p>
					</div>
					<div class="reason card space-50">
						<h5 class="text-neutral-50">Strategic Locations</h5>
						<p class="space-25-top">Our projects are strategically located in key micro-markets like Whitefield, which contributed <span class="text-primary">28% of Bangalore's total premium market transactions in 2024.</span></p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- End: NRI Reason Section -->



<!-- NRI Steps Section -->
<section class="nri-steps-section row small-gap">
	<div class="container">
		<div class="row">
			<div class="title columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 xlarge-6 xlarge-offset-3 text-center">
				<label class="section-label">Step-by-step Guide</label>
				<h2 class="section-heading text-neutral-20 w-600">Demystify the Buying Process</h2>
				<h6 class="section-sub-heading text-primary space-25-vertical">Navigate the complexity of buying property as an NRI</h6>
			</div>
			<div class="steps columns small-12 space-50-top">
				<div class="step card space-50">
					<div class="thumbnail"><img loading="lazy" class="block radius-25 box-shadow" src="media/genai-luxury-apartment.png" alt=""></div>
					<div class="info">
						<div class="h6 w-600">1. Discover Your Property</div>
						<p class="space-25-top">Explore our exclusive collection of luxury 3 & 4 BHK apartments, strategically designed for the global citizen.</p>
					</div>
				</div>
				<div class="step card space-50">
					<div class="thumbnail"><img loading="lazy" class="block radius-25 box-shadow" src="media/genai-rera-regulation.png" alt=""></div>
					<div class="info">
						<div class="h6 w-600">2. Understand the Framework</div>
						<p class="space-25-top">We provide a comprehensive guide on navigating the technical landscape for NRIs, including RERA and RBI regulations for property acquisition.</p>
					</div>
				</div>
				<div class="step card space-50">
					<div class="thumbnail"><img loading="lazy" class="block radius-25 box-shadow" src="media/genai-bank-fianace.png" alt=""></div>
					<div class="info">
						<div class="h6 w-600">3. Secure Your Finances</div>
						<p class="space-25-top">Get a clear breakdown of all costs. We also communicate available home loan facilities for NRIs.</p>
					</div>
				</div>
				<div class="step card space-50">
					<div class="thumbnail"><img loading="lazy" class="block radius-25 box-shadow" src="media/genai-key-handover.png" alt=""></div>
					<div class="info">
						<div class="h6 w-600">4. Effortless Ownership</div>
						<p class="space-25-top">Our commitment extends beyond the sale. With timely Occupancy Certificate and a Hassle-free ownership experience.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- End: NRI Steps Section -->



