<style>
	.csr-section .csr {
		font-size: 0;
		columns: 1;
		column-gap: var(--space-50);
		/*display: grid;*/
		/*gap: var(--space-50);*/
		/*grid-template-columns: repeat(1, 1fr);*/

		.info p {
			font-size: var(--label);
			padding-top: var(--space-25);
			white-space: pre-line;
		}
	}

	.csr-section .csr .card {
		display: grid;
		gap: var(--space-50);
		grid-template-columns: repeat(1, 1fr);
		margin-bottom: var(--space-50);
	}

	@media(min-width: 500px) {
		.csr-section .csr .card {
			/*grid-template-columns: repeat(2, 1fr);*/
		}
	}

	@media(min-width: 1000px) {
		.csr-section .csr {
			/*grid-template-columns: repeat(2, 1fr);*/
			columns: 2;
		}

		.csr-section .csr .card {
			grid-template-columns: repeat(1, 1fr);
		}
	}

	@media(min-width: 1500px) {
		.csr-section .csr {
			/*grid-template-columns: repeat(3, 1fr);*/
			columns: 3;
		}
	}
</style>
<section id="csr-section" class="csr-section gap">
	<div class="row">
		<div class="container">
			<div
				class="title columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 xlarge-6 xlarge-offset-3 text-center">
				<label class="section-label">{{ label }}</label>
				<h2 class="section-heading text-neutral-20 w-600">{{ heading }}</h2>
				<h6 class="section-sub-heading text-primary space-25-vertical">{{ sub-heading }}</h6>
				<p class="description space-25-top">{{ description }}</p>
			</div>
		</div>
	</div>
	<div class="row space-100-top">
		<div class="container">
			<div class="csr columns small-12">
				{% for entry in entry %}
				<div class="card space-50">
					<div class="thumbnail">
						{% image entry.image, "", "(min-width: 1000px) 50vw, 100vw", "lazy", "radius-min box-shadow block" %}
					</div>
					<div class="info">
						<h5 class="h5 w-600 space-25-bottom">{{ entry.title }}</h5>
						{% if entry.video %}
						<a class="block p fill-dark text-primary text-uppercase strong space-25-vertical space-50-horizontal radius-min"
							href="https://youtu.be/{{ entry.video }}"
							style="display: flex; align-items: center; justify-content: space-between;"
							target="_blank"><span class="inline">Watch the Film</span> <i class='inline bx bxl-youtube'
								style="transform: scale(1.5); transform-origin: right center;"></i></a>
						{% endif %}
						<p>{{ entry.description | newline_to_br }}</p>
					</div>
				</div>
				{% endfor %}
			</div>
		</div>
	</div>
	<div class="row space-200-top">
		<div class="container">
			<div
				class="title columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 xlarge-6 xlarge-offset-3 text-center">
				<label class="section-label">{{ partner.label }}</label>
				<h2 class="section-heading text-neutral-20 w-600">{{ partner.heading }}</h2>
				<h6 class="section-sub-heading text-primary space-25-vertical">{{ partner.sub-heading }}</h6>
			</div>
			<div class="title columns small-12 large-10 large-offset-1 xlarge-8 xlarge-offset-2 text-center">
				<p class="description space-25-top">{{ partner.description }}</p>
			</div>
		</div>
	</div>
</section>



