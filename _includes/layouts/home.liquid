<!-- About Vaswnani Section -->
<section id="about-vaswnani-section" class="about-vaswnani-section space-100-vertical">
	<div class="row">
		<div class="ribbon"><img src="media/ribbon-green.svg" alt=""></div>
		<div class="container about-vaswnani">
			<div class="columns small-6 medium-4 xlarge-3 xlarge-offset-1 inline-middle">
				<div class="logo"><img class="logo-image block" src="media/logo-color.svg" alt=""></div>
			</div>
			<div class="columns small-12 medium-7 medium-offset-1 xlarge-6 inline-middle">
				<div class="summary">
					<h2 class="heading h6 text-primary space-50-bottom">Over the last 40 years, we have developed residential and commercial real estate across Bangalore, Mumbai, Pune and Goa.</h2>
					<p class="description small space-50-bottom">In 1985, we embarked on a journey to offer global-standard residential solutions for the discerning home buyer as well as turnkey commercial solutions for Indian and multinational firms. From resplendent housing to upscale commercial, our equity is strengthened with a proven and credible track record having developed close to 8 million square feet of built up area in the verticals of Residential, Commercial, Retail and Hospitality. We are committed to constantly refining our skills with an ever present emphasis on transparency.</p>
					<a href="/about" class="button fill-dark">More about us</a>
				</div>
			</div>
		</div>
		<div class="ribbon flip"><img src="media/ribbon-green.svg" alt=""></div>
	</div>
</section>
<!-- End: About Vaswnani Section -->



