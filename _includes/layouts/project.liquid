---
eleventyComputed:
    title: "{% if overview.prefix-name %}Vaswani {% endif %}{{ name }}{% if overview.project-label %} - {{ overview.project-label }}{% endif %}"
---


{% include 'parts/head.liquid' %}
{% include 'parts/header.liquid' %}



<!-- Sample Section -->
<section id="sample-section" class="sample-section hidden">
	<div class="container">
		<div class="row">
			<div class="columns small-12">
				<!-- Stuff Goes Here -->
			</div>
		</div>
	</div>
</section>
<!-- End: Sample Section -->



<!-- Intro Banner Section -->
<section id="intro-banner-section" class="intro-banner-section">
	<div class="row">
		<div class="video-scroll-wrapper">
			<div class="video-width fill-dark" style="width: 100vw; padding-top: 50%;"></div>
			<div class="scroll">
				<span>Scroll</span>
				dotmatrix
			</div>
		</div>
			
	</div>
</section>
<!-- End: Intro Banner Section -->



<!-- Intro Section -->
<section id="intro-section" class="intro-section space-200-top space-100-bottom">
	<div class="row">
		<div class="container">
			<div class="title columns small-12 text-center space-25-bottom">
				<label class="section-label">{% if overview.prefix-name == true %}Vaswani {% endif %}{{ name }}</label>
				<h2 class="section-heading text-neutral-20 w-500 space-25-bottom">{% if intro.heading != blank %}{{ intro.heading }}{% endif %}</h2>
				<h6 class="heading text-primary">{% if overview.project-label != blank %}{{ overview.project-label }}{% endif %}</h6>
			</div>
		</div>
	</div>
	<div class="row">
		<!-- Carousel -->
		<div class="carousel gallery big-picture">
			<div class="carousel-list fill-white box-shadow-red-light">
				{% for gallery in gallery.images %}
				<div class="carousel-list-item">
					<img class="radius-25 box-shadow" src="{{ gallery.image }}" alt="">
				</div>
				{% endfor %}
			</div>
			<div class="row">
				<div class="carousel-controls container">
					<div class="scroll-button scroll-left inline" data-dir="left" tabindex="-1"><i class='bx bx-chevron-left h3 text-primary' ></i></div>
					<div class="scroll-button scroll-right inline" data-dir="right" tabindex="-1"><i class='bx bx-chevron-right h3 text-primary' ></i></div>
				</div>
			</div>
		</div>
		<!-- End: Carousel -->
	</div>
	<div class="intro row">
		<div class="container">
			<div class="columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 text-center space-125-top space-50-bottom">
				<h6 class="sub-heading text-primary">{{ intro.sub-heading }}</h6>
			</div>
		</div>
		<div class="container">
			<div class="project-meta text-dark columns small-12 medium-6 large-5 large-offset-1 xlarge-4 xlarge-offset-2 space-50-bottom text-center">
				{% if overview.starting-price != blank %}
				<small class="metadata block">
					<i class='bx bx-home p text-primary'></i>
					<span>{{ overview.starting-price }}</span>
				</small>
				{% endif %}
				{% if overview.unit-size != blank %}
				<small class="metadata block">
					<i class='bx bx-area p text-primary'></i>
					<span>{{ overview.unit-size }}</span>
				</small>
				{% endif %}
				{% if overview.location-label != blank %}
				<small class="metadata block">
					<i class='bx bx-map p text-primary'></i>
					<span>{{ overview.location-label }}</span>
				</small>
				{% endif %}
				{% if overview.location-label != blank %}
				<h6 class="space-25-top">
					<span class="text-neutral-40 w-600 text-uppercase">RERA Number</span>
					<span class="label block">PRM/KA/RERA/1251/446/PR/180424/006808</span>
				</h6>
				{% endif %}
			</div>
			<div class="description columns small-12 medium-6 large-5 xlarge-4 text-center">
				<p>{{ intro.description }}</p>
			</div>
		</div>
	</div>
</section>
<!-- End: Intro Section -->



<!-- Banner Section -->
{% if banner.feature-1 != blank %}
<section id="banner-section-1" class="banner-section space-100-vertical">
	<div class="container">
		<div class="row">
			<div class="columns small-12">
				<div class="banner img-cover radius-25 box-shadow" style="background-image: url('{{ banner.feature-1.background }}'); height: calc(var(--card)*1.5); width: 100%;">
					<h6 class="{{ banner.feature-1.position }}">{{ banner.feature-1.heading }}</h6>
				</div>
			</div>
		</div>
	</div>
</section>
{% endif %}
<!-- End: Banner Section -->



<!-- Contact Form Section -->
<section id="contact-form-section" class="contact-form-section space-100-vertical">
	<div class="container">
		<div class="row">
			<div class="columns small-12 xlarge-10 xlarge-offset-1">
				<label class="section-label">GET IN TOUCH</label>
				<h2 class="section-heading text-neutral-20 w-500 space-50-bottom">Exceptional Living Begins Here</h2>
			</div>
			<div class="columns small-12 space-50-bottom medium-4 xlarge-3 xlarge-offset-1">
				<p class="h6">Provide your details, and our expert advisors will connect with you to tailor your next steps.</p>
			</div>
			<div class="columns small-12 medium-7 medium-offset-1 xlarge-6">
				<div class="form card row space-50">
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">Full Name *</span>
							<input class="input-field" type="text">

						</label>
					</div>
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">Email Id *</span>
							<input class="input-field" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">Phone Number *</span>
							<input class="input-field" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">I’M Interested In</span>
							<input class="input-field" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">City</span>
							<input class="input-field" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">How Did You Find Us ?</span>
							<input class="input-field" type="text">
						</label>
					</div>
					<div class="form-input span-row">
						<label for="">
							<span class="input-label space-min block">Your Requirement</span>
							<textarea class="input-field" name="" id=""></textarea>
						</label>
					</div>
					<div class="form-input">
						<button class="button fill-primary" style="padding: 0 var(--space-100);">Contact</button>
					</div>
				</div>
			</div>
			<div class="columns or-message small-12 space-50-top medium-4 xlarge-3 xlarge-offset-1">
				<span class="h4 text-primary">OR</span>
				<p class="h6">Call our Help Desk <br>between 10am to 7pm IST</p>
				<a class="h4 text-primary" href="tel:+918747987479">+91-<strong>8747987479</strong></a>
			</div>
			<img class="dotmatrix" src="media/dot-matrix-large-green.svg" alt="">
		</div>
	</div>
</section>
<!-- End: Contact Form Section -->



