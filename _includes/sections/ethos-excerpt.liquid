<style>
	.ethos-excerpt-section {
		position: relative;

		.ethos-excerpt {
			.description p {
				margin-top: var(--space-50);
			}
		}
	}
	.ethos-excerpt-section .dotmatrix { display: none; }
	@media( min-width: 1000px ) {
		.ethos-excerpt-section .dotmatrix {
			display: block;
			position: absolute;
			z-index: -1;
			bottom: 0;
			right: 50%;
			width: calc(var(--card)/1.5);
			transform: translateX(var(--space-200));
			opacity: 66.666%;
		}
	}
</style>



<section id="ethos-excerpt-section" class="ethos-excerpt-section gap">
	<div class="row">
		<div class="container ethos-excerpt">
			<div class="columns small-12 large-10 large-offset-1 xlarge-8 xlarge-offset-2">
				<label class="section-label">{{ sections.ethos.label }}</label>
				<h2 class="section-heading text-neutral-20 w-600 space-25-bottom">{{ sections.ethos.heading }}</h2>
			</div>
			<div class="description columns small-12 space-50-bottom medium-5 large-4 large-offset-1 xlarge-3 xlarge-offset-2">
				<p class="p">{{ sections.ethos.description | newline_to_br }}</p>
			</div>
			<div class="columns small-12 space-25-top medium-6 medium-offset-1 large-5 xlarge-4">
				<img loading="lazy" class="radius-min block img-cover box-shadow" style="background-image: url('{{ sections.ethos.image }}'); padding-top: 100%;"></div>
			</div>
		</div>
		<img loading="lazy" class="dotmatrix" src="media/dot-matrix-large-yellow.svg" alt="">
	</div>
</section>