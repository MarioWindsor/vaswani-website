<section id="project-amenities-section" class="project-amenities-section gap">
	<div class="row">
		<div class="container">
			<div class="title columns small-12 text-center">
				<label class="section-label">Amenities</label>
				{% if amenities.heading != blank %}<h2 class="section-heading text-neutral-20 w-600">{{ amenities.heading }}</h2>{% endif %}
				{% if amenities.sub-heading != blank %}<h6 class="section-sub-heading text-primary space-25-vertical">{{ amenities.sub-heading }}</h6>{% endif %}
			</div>
			{% if amenities.cover-image != blank %}
			<div class="cover-image space-50-top">
				<img loading="lazy" class="radius-25 block" src="{{ amenities.cover-image }}" alt="">
			</div>
			{% endif %}
			<div class="row">
				{% if amenities.description != blank and amenities.amenity != blank %}
					<div class="columns small-12 medium-10 medium-offset-1 large-4 large-offset-0 xlarge-3 xlarge-offset-1 space-100-top">
						<p class="p description">{{ amenities.description | newline_to_br }}</p>
					</div>
				{% else %} 
					{% if amenities.description != blank %}
						<div class="columns small-12 medium-10 medium-offset-1 xlarge-8 xlarge-offset-2 space-100-top">
							<p class="p description">{{ amenities.description | newline_to_br }}</p>
						</div>
					{% endif %}
				{% endif %}
				{% if amenities.amenity != blank and amenities.description != blank %}
					<div class="columns small-12 medium-10 medium-offset-1 large-7 large-offset-1 xlarge-6 space-100-top">
						<ul class="amenities">
							{% for amenity in amenities.amenity %}
							<li class="amenity space-25-bottom">
								{% if amenity.icon != blank %}<img loading="lazy" class="inline-middle" src="{{ amenity.icon }}" alt="">{% endif %}
								{% if amenity.name != blank %}<span class="inline-middle">{{ amenity.name }}</span>{% endif %}
							</li>
							{% endfor %}
						</ul>
					</div>
				{% else %} 
					{% if amenities.amenity != blank %}
						<div class="columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 xlarge-6 xlarge-offset-3 space-100-top">
							<ul class="amenities">
								{% for amenity in amenities.amenity %}
								<li class="amenity space-25-bottom">
									{% if amenity.icon != blank %}<img loading="lazy" class="inline-middle" src="{{ amenity.icon }}" alt="">{% endif %}
									{% if amenity.name != blank %}<span class="inline-middle">{{ amenity.name }}</span>{% endif %}
								</li>
								{% endfor %}
							</ul>
						</div>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>
	<!-- Carousel -->
	{% if amenities.gallery != blank %}
	<div class="carousel gallery space-50-top">
		<div class="carousel-list">
			{% for gallery in amenities.gallery %}
			<div class="carousel-list-item">
				<img loading="lazy" class="radius-25 box-shadow" src="{{ gallery.image }}" alt="">
			</div>
			{% endfor %}
		</div>
		<div class="row">
			<div class="carousel-controls container">
				<div class="scroll-button scroll-left inline" data-dir="left" tabindex="-1"><i class='bx bx-chevron-left h3 text-primary' ></i></div>
				<div class="scroll-button scroll-right inline" data-dir="right" tabindex="-1"><i class='bx bx-chevron-right h3 text-primary' ></i></div>
			</div>
		</div>
	</div>
	{% endif %}
</section>