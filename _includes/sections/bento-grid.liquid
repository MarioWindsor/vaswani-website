<style>
	.bento-grid-section {}
	.bento-grid-section .bento-grid {
		display: grid;
		gap: var(--space-25);
		grid-auto-rows: calc((var(--card)/2) - (var(--space-25)/2));
		grid-template-columns: repeat(2, 1fr);
	}
	.bento-grid-section .bento-grid .bento {
		position: relative;
		overflow: clip;
	}
	@media( min-width: 500px )  {
		.bento-grid-section .bento-grid {
			gap: var(--space-50);
			grid-auto-rows: calc(var(--card) - var(--space-25));
		}
	}
	@media( min-width: 1000px ) {
		.bento-grid-section .bento-grid {
			grid-template-columns: repeat(4, 1fr);
			grid-auto-rows: calc((var(--card)*0.666) - var(--space-25));
		}
	}
	@media( min-width: 1500px ) { .bento-grid-section .bento-grid { grid-auto-rows: calc(var(--card) - var(--space-25)); } }
	/* b1 */
	.bento.b1 {
		grid-column: span 2;
		grid-row: span 2;
		font-size: 0;
		line-height: 0.8;
		color: var(--hue-primary);
	}
	.bento.b1 .text {
		position: absolute;
		top: 0;
		right: 0;
		display: inline-block;
		width: min-content;
		text-align: center;
		transform: scale(5) translate(10%, -10%);
		transform-origin: top right;
	}
	.bento.b1 .text-1 { display: inline-block; }
	.bento.b1 .text-2 {
		display: inline-block;
		transform: scale(0.925);
		transform-origin: top center;
	}
	@media( min-width: 500px )  { .bento.b1 .text { transform: scale(10) translate(10%, -10%); } }
	@media( min-width: 1000px ) { .bento.b1 .text { transform: scale(7.5) translate(10%, -10%); } }
	@media( min-width: 1500px ) { .bento.b1 .text { transform: scale(10) translate(10%, -10%); } }
	/* b2 */
	.bento.b2 {
		grid-column: span 2;
		background-color: var(--hue-primary);
		color: var(--hue-light);
	}
	.bento.b2 .text-1 {
		position: absolute;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		line-height: 0.95;
		transform: scale(2.5) translate(-10%, -10%);
		transform-origin: top left;

	}
	.bento.b2 .text-2 {
		position: absolute;
		right: var(--space-50);
		bottom: var(--space-50);
		display: inline-block;	
		text-align: right;
		line-height: 1.125;
	}
	@media( min-width: 500px )  {
		.bento.b2 { grid-column: span 1; }
		.bento.b2 .text-1 { transform: scale(3.95) translate(-10%, -10%); }
		.bento.b2 .text-2 {
			transform: scale(1.666);
			transform-origin: bottom right;
		}
	}
	@media( min-width: 1000px ) {
		.bento.b2 .text-1 { transform: scale(2.8) translate(-10%, -10%); }
		.bento.b2 .text-2 { transform: scale(1.125); }
	}
	@media( min-width: 1500px ) {
		.bento.b2 .text-1 { transform: scale(3.85) translate(-10%, -10%); }
		.bento.b2 .text-2 { transform: scale(1.5); }
	}
	/* b3 */
	.bento.b3 {
		grid-column: span 2;
		grid-row: span 2;
	}
	.bento.b3 .image {
		position: absolute;
		inset: 0;
		height: 100%;
	}
	@media( min-width: 500px )  {
		.bento.b3 {
			grid-column: span 1;
			grid-row: span 1;
		}
	}
	@media( min-width: 1000px ) {
		.bento.b3 {
			grid-column: span 1;
			grid-row: span 2;
		}
	}
	/* b4 */
	.bento.b4 { grid-column: span 2; }
	.bento.b4 .text {
		position: absolute;
		left: var(--space-50);
		bottom: var(--space-50);
		display: inline-block;	
		line-height: 1.125;
	}
	.bento.b4 .icon {
		position: absolute;
		top: calc(var(--space-100) * -1);
		right: calc(var(--space-50) * 1);
		width: calc(var(--card)* 0.5);
		height: calc(var(--card)* 0.5);
		display: inline-block;
		transform: scaleX(-1);
	}
	@media( min-width: 500px )  {
		.bento.b4 { grid-column: span 1; }
		.bento.b4 .text {
			transform: scale(1.666);
			transform-origin: bottom left;
		}
		.bento.b4 .icon {
			top: calc(var(--space-150) * -1);
			left: calc(var(--space-50) * -1);
			right: auto;
			width: calc(var(--card)* 0.75);
			height: calc(var(--card)* 0.75);
			transform: scaleX(1);
		}
	}
	@media( min-width: 1000px ) {
		.bento.b4 .text { transform: scale(1.125); }
		.bento.b4 .icon {
			top: calc(var(--space-50) * -1);
			left: calc(var(--space-25) * -1);
			width: calc(var(--card)* 0.4);
			height: calc(var(--card)* 0.4);
		}
	}
	@media( min-width: 1500px ) {
		.bento.b4 .text { transform: scale(1.5); }
		.bento.b4 .icon {
			top: calc(var(--space-75) * -1);
			left: calc(var(--space-25) * -1);
			width: calc(var(--card)* 0.65);
			height: calc(var(--card)* 0.65);
		}
	}
	/* b5 */
	.bento.b5 .image {
		position: absolute;
		inset: 0;
		height: 100%;
	}
	/* b6 */
	.bento.b6 .text {
		position: absolute;
		left: var(--space-50);
		bottom: var(--space-50);
		display: inline-block;	
		line-height: 1.125;
	}
	.bento.b6 .text-1 {
		display: inline-block;
		transform-origin: bottom left;
		transform: translateX(-2%);
	}
	@media( min-width: 500px )  {
		.bento.b6 .text {
			transform-origin: bottom left;
			transform: scale(1.666);
		}
		.bento.b6 .text-1 { font-size: var(--h2); }
		.bento.b6 .text-2 {
			display: inline-block;
			font-size: var(--h5);
		}
	}
	@media( min-width: 1000px ) { .bento.b6 .text { transform: scale(1.125); } }
	@media( min-width: 1500px ) { .bento.b6 .text { transform: scale(1.5); } }
	/* b7 */
	.bento.b7 {
		grid-column: span 2;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.bento.b7 .text {
		display: inline-block;
		position: relative;
		text-align: right;
		line-height: 0.9;
	}
	.bento.b7 .text-1 {
		display: inline-block;
		position: absolute;
		bottom: 95%;
		left: 0%;
		transform: rotate(90deg) scale(1.25);
		transform-origin: bottom left;
	}
	.bento.b7 .text-2 {
		padding-left: var(--h2);
		display: inline-block;
		font-size: calc(var(--h1)*1.7);
	}
	.bento.b7 .text-3 {
		padding-left: var(--h3);
		display: inline-block;
	}
	@media( min-width: 500px )  { .bento.b7 .text { transform: scale(2); } }
	@media( min-width: 1000px ) { .bento.b7 .text { transform: scale(1.333); } }
	@media( min-width: 1500px ) { .bento.b7 .text { transform: scale(1.9); } }
</style>



<section id="bento-grid-section" class="bento-grid-section gap not-white">
	<div class="container">
		<div class="row">
			<div class="bento-grid">
				<div class="bento b1 card">
					<div class="text">
						<span class="text-1 h1 w-600">40</span> <span class="text-2 h5 w-700 text-uppercase">years</span>
					</div>
				</div>
				<div class="bento b2 card">
					<div class="text">
						<span class="text-1"><span class="text-1-1 h1 w-600">8</span> <span class="text-1-2 h3 w-700">M+</span></span> <span class="text-2 h5 w-700 text-uppercase">Square Feet <br>Built-up Area</span> 
					</div>
				</div>
				<div class="bento b3 card hide-small hide-medium">
					<div class="image img-cover" style="position: relative; overflow: hidden;">
						{% image "media/DSC_8083.jpg", "Bento Grid Image", "50vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" %}
					</div>
				</div>
				<div class="bento b4 card">
					<div class="icon img-contain" style="background-image: url('media/icon-rowhouse.svg');"></div>
					<div class="text h5 text-uppercase">Pioneered <br><span class="text-primary">row house</span> in <br>Bengaluru</div>
				</div>
				<div class="bento b5 card">
					<div class="image img-cover" style="position: relative; overflow: hidden;">
						{% image "media/interior-designer-clients-discussing-drawings.jpg", "Interior Design Discussion", "(min-width: 1000px) 25vw, 50vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" %}
					</div>
				</div>
				<div class="bento b6 card">
					<div class="text">
						<span class="text-1 h3 w-600 text-primary">5000+</span> <br><span class="text-2 h6 text-uppercase">Happy <br>Customers</span>
					</div>
				</div>
				<div class="bento b7 card">
					<div class="text">
						<span class="text-1 h3 w-500 text-primary">100%</span> 
						<span class="text-2 h1 w-600 text-primary">RERA</span> <br>
						<span class="text-3 h3 w-700 text-uppercase">Compliance</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>