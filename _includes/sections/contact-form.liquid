<style>
	.contact-form-section .form {
		display: grid;
		gap: var(--small);
		grid-template-columns: repeat(1, 1fr);
	}
	.contact-form-section .dotmatrix { display: none; }
	@media( min-width: 500px ) {
		.contact-form-section .or-message {
			position: absolute;
			bottom: 0;
			left: 0;
			padding-bottom: var(--space-100);
		}
		.contact-form-section .dotmatrix {
			display: block;
			position: absolute;
			z-index: -1;
			bottom: var(--space-200);
			left: 25%;
			width: calc(var(--card)/1.5);
			opacity: 66.666%;
			transform: translate(-50%, -75%);
		}
	}
	@media( min-width: 1000px ) {
		.contact-form-section .form { grid-template-columns: repeat(2, 1fr); }
		.contact-form-section .form .form-input.span-row { grid-column: 1 / -1; }
		.contact-form-section .dotmatrix { transform: translate(-25%, -25%); }
	}
	@media( min-width: 1500px ) { .contact-form-section .dotmatrix { left: calc(25% + (var(--column-unit)/2)); } }
</style>



<section id="contact-form-section" class="contact-form-section gap">
	<div class="container">
		<div class="row">
			<div class="columns small-12 xlarge-10 xlarge-offset-1">
				<label class="section-label text-uppercase">Get in Touch</label>
				<h2 class="section-heading text-neutral-20 w-600 space-50-bottom">Exceptional Living Begins Here</h2>
			</div>
			<div class="columns small-12 space-50-bottom medium-4 xlarge-3 xlarge-offset-1">
				<p class="h6">Provide your details, and our expert advisors will connect with you to tailor your next steps.</p>
			</div>
			<div class="columns small-12 medium-7 medium-offset-1 xlarge-6">
				<form id="lead-form" class="form block card row space-50">
					<div class="form-input">
						<label for="f_name">
							<span class="input-label space-min block">Full Name *</span>
							<input class="input-field" id="f_name" name="f_name" type="text">

						</label>
					</div>
					<div class="form-input">
						<label for="email">
							<span class="input-label space-min block">Email Id *</span>
							<input class="input-field" id="email" name="email" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="phonefax">
							<span class="input-label space-min block">Phone Number *</span>
							<input class="input-field" id="phonefax" name="phonefax" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">I’M Interested In</span>
							<input class="input-field" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">City</span>
							<input class="input-field" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="">
							<span class="input-label space-min block">How Did You Find Us ?</span>
							<input class="input-field" type="text">
						</label>
					</div>
					<div class="form-input span-row">
						<label for="">
							<span class="input-label space-min block">Your Requirement</span>
							<textarea class="input-field" name="" id=""></textarea>
						</label>
					</div>
					<div class="form-input">
						<div class="visuallyhidden">
							<label for="project">Project:</label>
							<input type="text" id="project" name="project">
						</div>
						<div class="visuallyhidden">
							<label for="notes">Notes:</label>
							<textarea id="notes" name="notes"></textarea>
						</div>
						<button type="submit" class="button fill-primary" style="padding: 0 var(--space-100);">Contact</button>
					</div>
					<div id="form-status" role="status"></div>
				</form>
			</div>
			<div class="columns or-message small-12 space-50-top medium-4 xlarge-3 xlarge-offset-1">
				<span class="h4 text-primary">OR</span>
				<p class="h6">Call our Help Desk <br>between 10am to 7pm IST</p>
				<a class="h4 text-primary" href="tel:+918747987479">+91-<strong>8747987479</strong></a>
			</div>
			<img loading="lazy" class="dotmatrix" src="media/dot-matrix-large-green.svg" alt="">
		</div>
	</div>
</section>

<script>
  const form = document.getElementById('lead-form');
  const statusMessage = document.getElementById('form-status');

  form.addEventListener('submit', async (event) => {
    // 1. Stop the form from submitting normally
    event.preventDefault();
    
    // 2. Get all form data as a plain object
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    // 3. Show a 'loading' message
    statusMessage.textContent = 'Submitting...';
    
    try {
      // 4. Send the data to *your* Netlify Function
      const response = await fetch('/.netlify/functions/submit-lead', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      // 5. Get the response *from your function*
      const result = await response.json();

      if (response.ok) {
        // Handle Paramantra's success/duplicate messages
        if (result[0]?.status === 'failed' && result[0]?.message === 'duplicate_entry') {
          statusMessage.textContent = 'This contact number is already in our system.';
          statusMessage.style.color = 'blue';
        } else if (result[1]?.status === 'success') {
          statusMessage.textContent = 'Thank you! We have received your request.';
          statusMessage.style.color = 'green';
          form.reset(); // Clear the form
        } else {
          statusMessage.textContent = 'Submission received.';
          statusMessage.style.color = 'green';
        }
      } else {
        // Handle 4xx/5xx errors
        statusMessage.textContent = `Error: ${result.error || 'Submission failed.'}`;
        statusMessage.style.color = 'red';
      }

    } catch (error) {
      // 6. Handle network errors
      console.error('Submission error:', error);
      statusMessage.textContent = 'An error occurred. Please try again later.';
      statusMessage.style.color = 'red';
    }
  });
</script>