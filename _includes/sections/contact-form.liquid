<style>
	.contact-form-section .form {
		display: grid;
		gap: var(--small);
		grid-template-columns: repeat(1, 1fr);
	}
	@media( min-width: 500px ) {
		.contact-form-section .or-message {
			position: absolute;
			bottom: 0;
			left: 0;
			padding-bottom: var(--space-50);
		}

	}
	@media( min-width: 1000px ) {
		.contact-form-section .form { grid-template-columns: repeat(2, 1fr); }
	}
</style>



<section id="contact-form-section" class="contact-form-section gap not-white">
	<div class="container">
		<div class="row">
			<div class="columns small-12 xlarge-10 xlarge-offset-1">
				<label class="section-label text-uppercase">Get in Touch</label>
				<h2 class="section-heading text-neutral-20 w-600 space-75-bottom">Exceptional Living Begins Here</h2>
			</div>
			<div class="columns small-12 space-50-bottom medium-4 xlarge-3 xlarge-offset-1">
				<p class="h6">Provide your details, and our expert advisors will connect with you to tailor your next steps.</p>
			</div>
			<div class="columns small-12 medium-7 medium-offset-1 xlarge-6">
				<form name="lead" method="POST" netlify netlify-honeypot="nl_company" id="lead-form" class="form block card row space-50">
					<div class="form-input nl-first-name columns small-12 visuallyhidden">
						<label for="le_company" tabindex="-1">
							<span class="input-label space-min block">Company *</span>
							<input class="input-field" id="le_company" name="le_company" type="text" tabindex="-1">
						</label>
					</div>
					<div class="form-input">
						<label for="le_name">
							<span class="input-label space-min block">Full Name *</span>
							<input class="input-field" id="le_name" name="le_name" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="le_email">
							<span class="input-label space-min block">Email Id *</span>
							<input class="input-field" id="le_email" name="le_email" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="le_phone">
							<span class="input-label space-min block">Phone Number *</span>
							<input class="input-field" id="le_phone" name="le_phone" type="text">
						</label>
					</div>
					<div class="form-input">
						<label for="le_requirement">
							<span class="input-label space-min block">Your Requirement</span>
							<input class="input-field" id="le_requirement" name="le_requirement" type="text">
						</label>
					</div>
					<div class="form-input">
						<div class="visuallyhidden">
							<label for="le_page">Page</label>
							<input type="text" id="le_page" name="le_page">
						</div>
						<button type="submit" class="button fill-primary" style="padding: 0 var(--space-100); margin-top: var(--space-25); margin-left: calc(var(--space-min) * -0.5);">Contact Us</button>
					</div>
				</form>
				<div id="form-status" role="status"></div>
			</div>
			<div class="columns or-message small-12 space-50-top medium-4 xlarge-3 xlarge-offset-1">
				<span class="h4 text-primary">OR</span>
				<p class="h6">Call our Help Desk <br>{{ contact.phone.timings }}</p>
				<a class="h4 text-primary" href="tel:{{ contact.phone.number }}">{{ contact.phone.display }}</a>
			</div>
		</div>
	</div>
</section>