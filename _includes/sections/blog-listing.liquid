<section id="blog-section" class="blog-section gap">
	<div class="row">
		<div class="container">
			<div class="columns small-12 text-center space-25-bottom">
				<!-- <label class="section-label">Blog Articles</label> -->
				<label class="section-label">Shared Spaces</label>
				<h2 class="section-heading text-neutral-20 w-600">Insights &amp; Lifestyle Hub</h2>
			</div>
		</div>
	</div>
	<div class="row">
		<!-- Carousel -->
		<div class="carousel">
			<div class="carousel-list">
				{% for post in collections.blog %}
				<div class="carousel-list-item">
					<a href="{{ post.url }}" class="card article space-50" style="height: 100%; display: flex ; flex-direction: column;">
						<div class="thumbnail position-relative space-50-bottom">
							<div class="img-cover radius-min box-shadow" style="background-image: url('https://placeholdit.com/500x400/F1F1F1/999999'); padding-top: 80%;"></div>
						</div>
						<h5 class="text-primary space-min-bottom">{{ post.data.title }}</h5>
						<small class="block text-neutral-50 space-min-bottom">{{ post.date | date: "%b %d, %Y" }}</small>
						<p class="text-neutral-50 space-25-bottom">{{ post.content | strip_html | truncate: 185, "..." }}</p>
						<span class="p strong text-uppercase text-primary line-height-loose-loose" style="display: flex ; flex-grow: 1; align-items: flex-end;">View Article</span>
					</a>
				</div>
				{% endfor %}
			</div>
			<div class="row">
				<div class="carousel-controls container">
					<div class="scroll-button scroll-left inline" data-dir="left" tabindex="-1"><i class='bx bx-chevron-left h3 text-primary' ></i></div>
					<div class="scroll-button scroll-right inline" data-dir="right" tabindex="-1"><i class='bx bx-chevron-right h3 text-primary' ></i></div>
				</div>
			</div>
		</div>
	</div>
</section>