					</a>
					<div class="project-meta text-dark columns small-12 medium-5 large-4 inline-bottom">
						{% if project.data.metadata.starting-price != blank %}
						<small class="metadata block">
							<i class='bx bx-home p text-primary'></i>
							<span>{{ project.data.metadata.starting-price }}</span>
						</small>
						{% endif %}
						{% if project.data.metadata.unit-size != blank %}
						<small class="metadata block">
							<i class='bx bx-area p text-primary'></i>
							<span>{{ project.data.metadata.unit-size }}</span>
						</small>
						{% endif %}
						{% if project.data.metadata.location-label != blank %}
						<small class="metadata block">
							<i class='bx bx-map p text-primary'></i>
							<span>{{ project.data.metadata.location-label }}</span>
						</small>
						{% endif %}
					</div>
				</div>
				<!-- Carousel -->
				<div class="carousel gallery">
					<div class="carousel-list">
						{% if project.data.overview.gallery != blank %}
							{% for gallery in project.data.overview.gallery %}
							<a class="carousel-list-item" href="{{ project.url }}">
								<img class="radius-25 box-shadow" src="{{ gallery.image }}" alt="">
								{% if forloop.first %}
									{% if project.data.metadata.status-label != blank %}
									<small class="text-uppercase position-absolute space-min space-50-horizontal fill-secondary box-shadow" style="bottom: 15%; left: 0; border-top-right-radius: var(--space-min); border-bottom-right-radius: var(--space-min);">{{ project.data.metadata.status-label }}</small>
									{% endif %}
								{% endif %}
							</a>
							{% endfor %}
						{% else %}
							<a class="carousel-list-item" href="{{ project.url }}">
								<img class="radius-25 box-shadow" src="
								{% if project.data.cover.background != blank %}
									{{ project.data.cover.background }}
								{% else %}
									media/fallback.jpg
								{% endif %}
								" alt="">
								{% if project.data.metadata.status-label != blank %}
								<small class="text-uppercase position-absolute space-min space-50-horizontal fill-secondary box-shadow" style="bottom: 15%; left: 0; border-top-right-radius: var(--space-min); border-bottom-right-radius: var(--space-min);">{{ project.data.metadata.status-label }}</small>
								{% endif %}
							</a>
						{% endif %}
					</div>
					<div class="row">
						<div class="carousel-controls container">
							<div class="scroll-button scroll-left inline" data-dir="left" tabindex="-1"><i class='bx bx-chevron-left h3 text-primary' ></i></div>
							<div class="scroll-button scroll-right inline" data-dir="right" tabindex="-1"><i class='bx bx-chevron-right h3 text-primary' ></i></div>
						</div>
					</div>
				</div>
				<div class="container">
					<a class="button space-75-horizontal radius-round" href="{{ project.url }}">Explore Project</a>
				</div>
			</div>
			{% endfor %}
		</div>
	</div>
	<!-- End: Pair List -->
</section>