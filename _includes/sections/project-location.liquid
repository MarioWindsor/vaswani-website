<style>
	.location-section .places {}
	.location-section .places label {
		display: inline-flex;
		align-items: center;
		cursor: pointer;
		line-height: 0.5;
	}
	.location-section .places label * { pointer-events: none; }
	.location-section .places label .bx-minus { display: none; }
	.location-section .places label .title { padding-left: var(--space-min) }
	.location-section .places .place-list {
		display: block;
		width: 100%;
		height: auto;
		max-height: 0px;
		overflow: clip;
		transition: max-height .7s ease-in-out;
		margin: var(--space-25) 0;
		padding-left: calc(var(--space-25) * 1.5);
	}

	.location-section .places .places-radio:checked + label { color: var(--hue-primary); }
	.location-section .places .places-radio:checked + label .bx-minus { display: inline-block; }
	.location-section .places .places-radio:checked + label .bx-plus { display: none; }
	.location-section .places .places-radio:checked ~ .place-list { max-height: 100vh; }

	.location-section .dotmatrix { display: none; }
	@media( min-width: 500px ) {}
	@media( min-width: 1000px ) {
		.location-section .section-sub-heading { font-size: var(--h5); }
		.location-section .dotmatrix {
			display: block;
			position: absolute;
			z-index: -1;
			top: 0;
			left: 25%;
			width: calc(var(--card)/1.5);
			opacity: 25%;
			transform: translate(-25%, 175%);
		}
	}
	@media( min-width: 1500px ) {
		.location-section .dotmatrix {
			transform: translate(-25%, 200%);
			left: calc(25% + (var(--column-unit)/2)); 
		}
	}
</style>



<section id="location-section" class="location-section gap">
	<div class="container">
		<div class="row">
			<div class="columns small-12 xlarge-10 xlarge-offset-1 space-25-bottom">
				<label tabindex="0" class="section-label text-uppercase">Location</label>
				<h2 class="section-heading text-neutral-20 w-600">{{ location.heading }}</h2>
			</div>
			<div class="columns small-12 large-4 xlarge-3 xlarge-offset-1">
				<div class="row">
					<div class="columns small-12 medium-5 large-12 space-50-top">
						<h3 class="section-sub-heading h6 text-primary">{{ location.sub-heading }}</h3>
						<p class="label space-50-top">{{ location.description }}</p>
					</div>
					<div class="columns small-12 medium-6 medium-offset-1 large-12 large-offset-0 space-50-top">
					{% for places in location.places %}
						<div class="places">
							<input class="places-radio visuallyhidden" type="radio" id="{{ places.name | slugify }}" name="places-group" {% if forloop.index == 1 %}checked{% endif %}>
							<label for="{{ places.name | slugify }}">
								<i class='bx bx-plus h4 text-primary'></i>
								<i class='bx bx-minus h4 text-primary'></i>
								<h3 class="title">{{ places.name }}</h3>
							</label>
							<div class="place-list">
								{% for place in places.place %}
								<p class="place">{{ place.distance }} : {{ place.name }}</p>
								{% endfor %} 
							</div>
						</div>
					{% endfor %}
					</div>
				</div>
			</div>
			<div class="columns small-12 large-7 large-offset-1 xlarge-6 space-50-top">
				<div class="google-map block card" style="position: relative; height: 0; padding-top: 100%;">
					<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1594.8431091199511!2d77.73660262614308!3d12.977434744615737!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae11f093ce84ed%3A0x181d9c5cb50023cf!2sVaswani%20Starlight!5e0!3m2!1sen!2sin!4v1755611327119!5m2!1sen!2sin" style="border:0; width: 100%; height: 100%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>
			<img class="dotmatrix" src="media/dot-matrix-large-green.svg" alt="">
		</div>
	</div>
</section>