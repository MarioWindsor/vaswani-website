<section id="" class="project-banner-section gap">
	<div class="container">
		<div class="row">
			<div class="columns small-12">
				<div class="project-banner img-cover radius-25 box-shadow" style="
				{% if banner.align-text != blank %}
					text-align: {{ banner.align-text }};
					justify-content: {% if banner.align-text == 'right' %}flex-end{% else %}{% if banner.align-text == 'center' %}center{% else %}flex-start{% endif %}{% endif %};
				{% endif %}
				{% if banner.position-text != blank %}
					align-items: {% if banner.position-text == 'right' %}flex-end{% else %}{% if banner.position-text == 'center' %}center{% else %}flex-start{% endif %}{% endif %};
				{% endif %}
				background: none; position: relative; overflow: hidden; height: calc(var(--card)*1.5); width: 100%;">
					{% if banner.background != blank %}
						{% image banner.background, "", "100vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; filter: brightness(0.85);" %}
					{% else %}
						{% image "/media/fallback.jpg", "", "100vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; filter: brightness(0.85);" %}
					{% endif %}
					<div style="position: relative; z-index: 1;">
						{% if banner.heading != blank %}
							<h6 class="heading h5 text-light">{{ banner.heading }}</h6>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
		{% if banner.description %}
		<div class="row">
			<div class="p text-neutral-50 columns small-12 text-center medium-10 medium-offset-1 xlarge-8 xlarge-offset-2 space-75-top">
				{{ banner.description }}
			</div>
		</div>
		{% endif %}
	</div>
</section>