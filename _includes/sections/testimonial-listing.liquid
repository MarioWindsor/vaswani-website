<section id="testimonials-section" class="testimonials-section gap">
	<div class="row">
		<div class="container">
			<div class="columns small-12 text-center space-25-bottom">
				<label class="section-label">Testimonials</label>
				<h2 class="section-heading text-neutral-20 w-600">Voices of Trust</h2>
			</div>
		</div>
	</div>
	<div class="row">
		<!-- Carousel -->
		<div class="carousel">
			<div class="carousel-list">
				{% for testimon in collections.testimonials %}
				<div class="carousel-list-item card testimonial space-50">
					<h5 class="text-primary space-min-bottom">{{ testimon.data.title }}</h5>
					<small class="block text-neutral-50 space-min-bottom">{{ testimon.date | date: "%B %Y" }}</small>
					<h5 class="space-25-bottom">{% for i in (1..testimon.data.rating) %}⭐{% endfor %}</h5>
					<p class="text-neutral-50">{{ testimon.data.review }}</p>
				</div>
				{% endfor %}
			</div>
			<div class="row">
				<div class="carousel-controls container">
					<div class="scroll-button scroll-left inline" data-dir="left" tabindex="-1"><i class='bx bx-chevron-left h3 text-primary' ></i></div>
					<div class="scroll-button scroll-right inline" data-dir="right" tabindex="-1"><i class='bx bx-chevron-right h3 text-primary' ></i></div>
				</div>
			</div>
		</div>
	</div>
</section>