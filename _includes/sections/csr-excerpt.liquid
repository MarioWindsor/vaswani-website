<style>
	.csr-excerpt-section { position: relative; }
	.csr-excerpt-section .dotmatrix { display: none; }
	@media( min-width: 1000px ) {
		.csr-excerpt-section .dotmatrix {
			display: block;
			position: absolute;
			z-index: -1;
			bottom: 0;
			right: 50%;
			width: calc(var(--card)/1.5);
			transform: translateX(var(--space-200));
			opacity: 66.666%;
		}
	}
</style>



<section id="csr-excerpt-section" class="csr-excerpt-section gap">
	<div class="row">
		<div class="container">
			<div class="columns small-12 large-10 large-offset-1 xlarge-8 xlarge-offset-2">
				<label class="section-label">{{ sections.csr.label }}</label>
				<h2 class="section-heading text-neutral-20 w-600 space-25-bottom">{{ sections.csr.heading }}</h2>
			</div>
			<div class="columns small-12 space-50-vertical medium-5 large-4 large-offset-1 xlarge-3 xlarge-offset-2">
				<p class="h6 space-50-bottom">{{ sections.csr.description }}</p>				
				<a class="button fill-dark" href="{{ sections.csr.link.url }}">{{ sections.csr.link.text }}</a>
			</div>
			<div class="columns small-12 space-25-top medium-6 medium-offset-1 large-5 xlarge-4">
				<!-- <img loading="lazy" class="radius-min block box-shadow" src="{{ sections.csr.image }}" alt=""> -->
				{% image sections.csr.image, "", "(min-width: 1000px) 50vw, 100vw", "lazy", "radius-min block box-shadow" %}
			</div>
		</div>
		<img loading="lazy" class="dotmatrix" src="media/dot-matrix-large-yellow.svg" alt="">
	</div>
</section>