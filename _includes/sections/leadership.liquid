<style>
	.leadership-section .leadership {
		display: grid;
		gap: var(--space-100);
	}
	.leadership-section .leadership .leader {
		display: grid;
		gap: var(--space-25);
	}
	@media( min-width: 500px )  {
		.leadership-section .leadership {
			gap: var(--space-125);
		}
		.leadership-section .leadership .leader {
			grid-template-columns: repeat(2, 1fr);
			align-items: center;
			gap: var(--space-100);
		}
		.leadership-section .leadership .leader:nth-child(2n) .photo {
			order: 2;
		}
	}
	@media( min-width: 1000px ) {
		.leadership-section .leadership .leader .info .name { font-size: var(--h4); }
		.leadership-section .leadership .leader .info .description { font-size: var(--p); }
	}
	@media( min-width: 1500px ) {}
</style>
<section id="leadership-section" class="leadership-section gap">
	<div class="row">
		<div class="container">
			<div class="title columns small-12 medium-10 medium-offset-1 large-8 large-offset-2 xlarge-6 xlarge-offset-3 text-center">
				<label class="section-label">{{ leadership.label }}</label>
				<h2 class="section-heading text-neutral-20 w-600">{{ leadership.heading }}</h2>
				<h6 class="section-sub-heading space-25-vertical">{{ leadership.sub-heading }}</h6>
			</div>
		</div>
	</div>
	<div class="row space-100-top">
		<div class="container">
			<div class="leadership columns small-12 large-10 large-offset-1 xlarge-8 xlarge-offset-2">
				{% for leader in leadership.profiles %}
				<div class="leader">
					<div class="photo">
						<!-- <img loading="lazy" class="radius-min block box-shadow" src="{{ leader.image }}" width="800" height="800" alt="{{ leader.name }}" style="width: 100%; height: var(--card); max-height: none; object-fit: cover;"> -->
						{% image leader.image, leader.name, "(min-width: 500px) 50vw, 100vw", "lazy", "radius-min block box-shadow", "width: 100%; min-height: var(--card); height: 100%; max-height: none; object-fit: cover;" %}
					</div>
					<div class="info space-25">
						<div class="name h5 text-primary">{{ leader.name }}</div>
						<small class="role text-neutral-30 strong">{{ leader.role }}</small>
						<p class="description small space-25-top">{{ leader.description | newline_to_br }}</p>
					</div>
				</div>
				{% endfor %}
			</div>
		</div>
	</div>
</section>