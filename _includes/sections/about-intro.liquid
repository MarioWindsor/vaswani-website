<style>
	.about-intro-section { position: relative; z-index: 1; }
	.about-intro-section .about-intro-bg { position: relative; z-index: 1; }
	.about-intro-section .about-intro-bg:after {
		position: absolute;
		display: block;
		content: '';
		z-index: 2;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 25vw;
		background: linear-gradient(to top, var(--hue-light), transparent);
	}
	.about-intro-section .about-intro {
		position: relative;
		z-index: 2;
		margin-top: -4vw;

		.description p {
			margin-top: var(--space-50);
		}
	}
	@media( min-width:  500px ) {}
	@media( min-width: 1000px ) {}
	@media( min-width: 1500px ) {}
</style>



<section id="about-intro-section" class="about-intro-section">
	<div class="row">
		<div class="about-intro-bg fill-light">
			{% image "media/about-cover-min.png", "", "100vw", "lazy", "block" %}
		</div>
		<div class="about-intro">
			<div class="container">
				<div class="text-center columns small-12">
					<label class="section-label">{{ intro.label }}</label>
					<h2 class="section-heading text-neutral-20 w-600">{{ intro.heading }}</h2>
					<h6 class="section-sub-heading text-primary space-25-vertical">{{ intro.sub-heading }}</h6>
				</div>
				<div class="description text-center columns small-12 medium-10 large-8 xlarge-6 medium-offset-1 large-offset-2 xlarge-offset-3">
					<p>{{ intro.description | newline_to_br }}</p>
				</div>
				<div id="brand-film" class="text-center columns small-12 medium-10 xlarge-8 medium-offset-1 xlarge-offset-2 space-75-top">
					<small class="block text-uppercase text-primary space-50-bottom">Watch the Brand Film</small>
					<div class="video-embed radius-min box-shadow">
						<iframe class="" src="https://www.youtube-nocookie.com/embed/{{ intro.video_id }}?html5=1&color=white&disablekb=0&fs=1&autoplay=0&loop=0&modestbranding=1&playsinline=1&rel=0&showinfo=0&enablejsapi=1&mute=0&controls=1" title="YouTube video player" frameborder="0" allow="autoplay; accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>