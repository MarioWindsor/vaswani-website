{% assign masterplan_count = siteplan.masterplan | size %}
{% assign floorplan_count = siteplan.floorplan | size %}
<section id="project-siteplan-section" class="project-siteplan-section gap">
	<div class="row">
		<div class="container">
			<div class="title columns small-12 text-center space-50-bottom">
				<label class="section-label">Siteplan</label>
				<h2 class="section-heading text-neutral-20 w-600">{% if siteplan.heading != blank %}{{ siteplan.heading }}{% endif %}</h2>
				<h6 class="section-sub-heading text-primary space-25-vertical">{% if siteplan.sub-heading != blank %}{{ siteplan.sub-heading }}{% endif %}</h6>
			</div>
		</div>
	</div>
	<input class="pair-toggle-input visuallyhidden position-absolute" type="radio" name="siteplanToggle" value="residential" id="siteplanToggleMasterplan" checked>
	<input class="pair-toggle-input visuallyhidden position-absolute" type="radio" name="siteplanToggle" value="commercial" id="siteplanToggleFloorplan">
	{% if siteplan.masterplan != blank and siteplan.floorplan != blank %}
	<!-- Pair Toggle -->
	<div class="pair-toggle row space-100-bottom">
		<div class="container text-center">
			<div class="columns small-12 medium-6 large-4 xlarge-3 text-center">
				<div class="pair-toggle-button inline space-25 fill-neutral-10 radius-round box-shadow-inset">
					<label class="button text-uppercase radius-round space-75-horizontal" for="siteplanToggleMasterplan">Masterplan</label>
					<label class="button text-uppercase radius-round space-75-horizontal" for="siteplanToggleFloorplan">Floorplan</label>
					<span class="button button-bg text-uppercase radius-round space-75-horizontal"></span>
				</div>
			</div>
		</div>
	</div>
	<!-- End: Pair Toggle -->
	{% endif %}
	<!-- Pair List -->	
	<div class="pair-list row">
		{% if siteplan.masterplan != blank %}
		<div class="project-siteplan pair-content masterplan carousel" {% if siteplan.floorplan == blank %}style="display: block;"{% endif %}>
			<div class="container">
				{% if masterplan_count > 1 %}
					<select class="select-siteplan button fill-dark box-shadow" id="selectMasterplan">
					{% for plan in siteplan.masterplan %}
						<option value="masterplan-{{ plan.title | slugify }}">{{ plan.title }}</option>
					{% endfor %}
					</select>
				{% endif %}
				{% for siteplan in siteplan.masterplan %}
				<input class="siteplan-radio visuallyhidden" type="radio" name="masterplan-radio-group" id="masterplan-{{ siteplan.title | slugify }}" {% if forloop.first == true %}checked{% endif %}>
				<div class="siteplan radius-25 box-shadow-primary overflow-clip">
					{% comment %}
						<iframe src="https://indis.co.in/leaflet-map?id=PBELCity-MasterPlan-21jul2022" frameborder="0"></iframe>
					{% endcomment %}
					<img loading="lazy" class="block" src="{{ siteplan.image }}" alt="">
					<a class="button box-shadow zoom-icon" href="{{ siteplan.image }}" target="_blank">
						<span class="visuallyhidden">Zoom In</span>
						<i class='h6 bx bx-zoom-in'></i>
					</a>
				</div>
				{% endfor %}
			</div>
		</div>
		{% endif %}
		{% if siteplan.floorplan != blank %}
		<div class="project-siteplan pair-content floorplan carousel" {% if siteplan.masterplan == blank %}style="display: block;"{% endif %}>
			<div class="container">
				{% if floorplan_count > 1 %}
					<small class="select-siteplan-label text-uppercase text-light w-600">Pick an Option</small>
					<select class="select-siteplan button fill-dark box-shadow" id="selectFloorplan">
					{% for plan in siteplan.floorplan %}
						<option value="floorplan-{{ plan.title | slugify }}">{{ plan.title }}</option>
					{% endfor %}
					</select>
				{% endif %}
				{% for siteplan in siteplan.floorplan %}
				<input class="siteplan-radio visuallyhidden" type="radio" name="floorplan-radio-group" id="floorplan-{{ siteplan.title | slugify }}" {% if forloop.first == true %}checked{% endif %}>
				<div class="siteplan radius-25 box-shadow-primary overflow-clip">
					{% comment %}
						<iframe src="https://indis.co.in/leaflet-map?id=PBELCity-MasterPlan-21jul2022" frameborder="0"></iframe>
					{% endcomment %}
					<img loading="lazy" class="block" src="{{ siteplan.image }}" alt="">
					<a class="button box-shadow zoom-icon" href="{{ siteplan.image }}" target="_blank">
						<span class="visuallyhidden">Zoom In</span>
						<i class='h6 bx bx-zoom-in'></i>
					</a>
				</div>
				{% endfor %}
			</div>
		</div>
		{% endif %}
	</div>
	<!-- End: Pair List -->
</section>


<script>
document.addEventListener('DOMContentLoaded', () => {

	// Find the Elements
	const toggleFloorplan = document.getElementById('selectFloorplan');
	const toggleMasterplan = document.getElementById('selectMasterplan');

	toggleFloorplan.addEventListener('change', (event) => {
		const newValue = event.target.value;

		const targetRadio = document.getElementById(newValue);

		// Check if the radio button was found
		if (targetRadio) {
			// Set the 'checked' property to true
			targetRadio.checked = true;
			console.log(`Radio button with ID '${newValue}' has been checked.`);
		} else {
			console.error(`Radio button with ID '${newValue}' not found.`);
		}
	});

	toggleMasterplan.addEventListener('change', (event) => {
		const newValue = event.target.value;

		const targetRadio = document.getElementById(newValue);

		// Check if the radio button was found
		if (targetRadio) {
			// Set the 'checked' property to true
			targetRadio.checked = true;
			console.log(`Radio button with ID '${newValue}' has been checked.`);
		} else {
			console.error(`Radio button with ID '${newValue}' not found.`);
		}
	});
});
</script>