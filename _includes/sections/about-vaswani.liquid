<style>
	.about-vaswani-section .ribbon { overflow: clip; }
	.about-vaswani-section .ribbon img {
		width: 100%;
		max-width: none;
		height: var(--space-150);
		object-fit: cover;
	}
	.about-vaswani-section .ribbon.flip { transform: scaleY(-1); }
	.about-vaswani-section .about-vaswani { padding-bottom: var(--space-150); }
	@media( min-width: 500px ) {
		.about-vaswani-section .ribbon img {
			width: calc(100% + (var(--card) * 0.666));
			transform: translateX(calc(var(--card) * -0.666));
		}
		.about-vaswani-section .about-vaswani {
			padding-top: var(--space-150);
			padding-bottom: var(--space-150);
		}
	}
	@media( min-width: 1000px ) {
		.about-vaswani-section .ribbon img {
			width: calc(100% + (var(--card) * 1));
			transform: translateX(calc(var(--card) * -1));
		}
		.about-vaswani-section .about-vaswani .summary .heading { font-size: var(--h4); }
		.about-vaswani-section .about-vaswani .summary .description { font-size: var(--label); }
	}
	@media( min-width: 1500px ) {
		.about-vaswani-section .ribbon img {
			height: var(--space-175);
			width: calc(100% + (var(--card) * 1.333));
			transform: translateX(calc(var(--card) * -1.333));
		}
	}
</style>



<section id="about-vaswani-section" class="about-vaswani-section gap">
	<div class="row">
		<div class="ribbon"><img loading="lazy" src="media/ribbon-green.svg" alt=""></div>
		<div class="container about-vaswani">
			<div class="columns small-6 medium-4 xlarge-3 xlarge-offset-1 inline-middle">
				<div class="logo"><img loading="lazy" class="logo-image block" src="media/logo-color.svg" alt=""></div>
			</div>
			<div class="columns small-12 medium-7 medium-offset-1 xlarge-6 inline-middle">
				<div class="summary">
					<h2 class="heading h6 text-primary space-50-bottom">{{ sections.about.heading }}</h2>
					<p class="description small space-50-bottom">{{ sections.about.description |  newline_to_br }}</p>
					<a href="{{ sections.about.link.url }}" class="button fill-dark">{{ sections.about.link.text }}</a>
				</div>
			</div>
		</div>
		<div class="ribbon flip"><img loading="lazy" src="media/ribbon-green.svg" alt=""></div>
	</div>
</section>