<!-- 
	Variables Defined in head.liquid :
	completed_projects, completed_residential_projects, completed_commercial_projects
 -->

<section id="project-listing-section" class="project-listing-section completed gap">
	<div class="row">
		<div class="container">
			<div class="columns small-12 text-center">
				<label class="section-label">Completed Projects</label>
				<h2 class="section-heading text-neutral-20 w-600 space-50-bottom">Our Legacy of Landmarks</h2>
			</div>
		</div>
	</div>
	<input class="pair-toggle-input visuallyhidden position-absolute" type="radio" name="completedToggle" value="residential" id="completedToggleResidential" checked>
	<input class="pair-toggle-input visuallyhidden position-absolute" type="radio" name="completedToggle" value="commercial" id="completedToggleCommercial">
	<!-- Pair Toggle -->
	<div class="pair-toggle row">
		<div class="container text-center">
			<div class="columns small-12 medium-6 large-4 xlarge-3 text-center">
				<div class="pair-toggle-button inline space-25 fill-neutral-10 radius-round box-shadow-inset">
					<label class="button text-uppercase radius-round space-75-horizontal" for="completedToggleResidential">Residential</label>
					<label class="button text-uppercase radius-round space-75-horizontal" for="completedToggleCommercial">Commercial</label>
					<span class="button button-bg text-uppercase radius-round space-75-horizontal"></span>
				</div>
			</div>
		</div>
	</div>
	<!-- End: Pair Toggle -->
	<!-- Pair List -->
	<div class="pair-list row space-100-top">
		<div class="projects pair-content residential carousel">
			<div class="carousel-list">
				{% for project in completed_residential_projects %}
				<div class="project carousel-list-item">
					{% if project.url %}
					<a class="card space-50" href="{{ project.url }}" style="height: 100%; display: flex ; flex-direction: column;">
					{% else %}
					<div class="card space-50" style="height: 100%; display: flex ; flex-direction: column; opacity: 0.5; pointer-events: none; filter: grayscale(1);">
					{% endif %}
						<div class="thumbnail position-relative">
							<div class="img-cover radius-min box-shadow" style="position: relative; overflow: hidden; padding-top: 80%;">
								{% if project.data.cover.background != blank %}
									{% image project.data.cover.background, "", "(min-width: 1000px) 33vw, (min-width: 500px) 50vw, 100vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;" %}
								{% else %}
									{% image "media/fallback.jpg", "", "(min-width: 1000px) 33vw, (min-width: 500px) 50vw, 100vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;" %}
								{% endif %}
							</div>
							{% if project.data.metadata.status-label != blank %}
							<small class="text-uppercase position-absolute space-min space-50-horizontal fill-secondary box-shadow" style="bottom: 15%; left: 0; border-top-right-radius: var(--space-min); border-bottom-right-radius: var(--space-min);">{{ project.data.metadata.status-label }}</small>
							{% endif %}
							<!-- <small class="text-uppercase position-absolute space-min space-50-horizontal fill-secondary box-shadow" style="bottom: 15%; left: 0; border-top-right-radius: var(--space-min); border-bottom-right-radius: var(--space-min);">Completed 2017</small> -->
						</div>
						<h6 class="text-primary space-50-top text-uppercase strong letter-spacing-loose-loose">{% if project.data.metadata.prefix-name == true %}Vaswani {% endif %}{{ project.data.name }}</h6>
						<p class="block text-neutral-50">{% if project.data.metadata.project-label != blank %}{{ project.data.metadata.project-label }}{% endif %}</p>
						<div class="project-meta text-dark space-25-vertical">
							{% if project.data.metadata.starting-price != blank %}
							<small class="metadata block">
								<i class='bx bx-home p text-primary'></i>
								<span>{{ project.data.metadata.starting-price }}</span>
							</small>
							{% endif %}
							{% if project.data.metadata.unit-size != blank %}
							<small class="metadata block">
								<i class='bx bx-area p text-primary'></i>
								<span>{{ project.data.metadata.unit-size }}</span>
							</small>
							{% endif %}
							{% if project.data.metadata.location-label != blank %}
							<small class="metadata block">
								<i class='bx bx-map p text-primary'></i>
								<span>{{ project.data.metadata.location-label }}</span>
							</small>
							{% endif %}
						</div>
						<span class="p strong text-uppercase text-primary line-height-loose-loose" style="display: flex ; flex-grow: 1; align-items: flex-end;">{% if project.url %}View Project{% else %}Completed{% endif %}</span>
					{% if project.url %}</a>{% else %}</div>{% endif %}
				</div>
				{% endfor %}
			</div>
			<div class="row">
				<div class="carousel-controls container">
					<div class="scroll-button scroll-left inline" data-dir="left" tabindex="-1"><i class='bx bx-chevron-left h3 text-primary' ></i></div>
					<div class="scroll-button scroll-right inline" data-dir="right" tabindex="-1"><i class='bx bx-chevron-right h3 text-primary' ></i></div>
				</div>
			</div>
		</div>
		<div class="projects pair-content commercial carousel">
			<div class="carousel-list">
				{% for project in completed_commercial_projects %}
				<div class="project carousel-list-item">
					{% if project.url %}
					<a class="card space-50" href="{{ project.url }}" style="height: 100%; display: flex ; flex-direction: column;">
					{% else %}
					<div class="card space-50" style="height: 100%; display: flex ; flex-direction: column; opacity: 0.5; pointer-events: none; filter: grayscale(1);">
					{% endif %}
						<div class="thumbnail position-relative">
							<div class="img-cover radius-min box-shadow" style="position: relative; overflow: hidden; padding-top: 80%;">
								{% if project.data.cover.background != blank %}
									{% image project.data.cover.background, "", "(min-width: 1000px) 33vw, (min-width: 500px) 50vw, 100vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;" %}
								{% else %}
									{% image "media/fallback.jpg", "", "(min-width: 1000px) 33vw, (min-width: 500px) 50vw, 100vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;" %}
								{% endif %}
							</div>
							{% if project.data.metadata.status-label != blank %}
							<small class="text-uppercase position-absolute space-min space-50-horizontal fill-secondary box-shadow" style="bottom: 15%; left: 0; border-top-right-radius: var(--space-min); border-bottom-right-radius: var(--space-min);">{{ project.data.metadata.status-label }}</small>
							{% endif %}
							<!-- <small class="text-uppercase position-absolute space-min space-50-horizontal fill-secondary box-shadow" style="bottom: 15%; left: 0; border-top-right-radius: var(--space-min); border-bottom-right-radius: var(--space-min);">Completed 2017</small> -->
						</div>
						<h6 class="text-primary space-50-top text-uppercase strong letter-spacing-loose-loose">{% if project.data.metadata.prefix-name == true %}Vaswani {% endif %}{{ project.data.name }}</h6>
						<p class="block text-neutral-50">{% if project.data.metadata.project-label != blank %}{{ project.data.metadata.project-label }}{% endif %}</p>
						<div class="project-meta text-dark space-25-vertical">
							{% if project.data.metadata.starting-price != blank %}
							<small class="metadata block">
								<i class='bx bx-home p text-primary'></i>
								<span>{{ project.data.metadata.starting-price }}</span>
							</small>
							{% endif %}
							{% if project.data.metadata.unit-size != blank %}
							<small class="metadata block">
								<i class='bx bx-area p text-primary'></i>
								<span>{{ project.data.metadata.unit-size }}</span>
							</small>
							{% endif %}
							{% if project.data.metadata.location-label != blank %}
							<small class="metadata block">
								<i class='bx bx-map p text-primary'></i>
								<span>{{ project.data.metadata.location-label }}</span>
							</small>
							{% endif %}
						</div>
						<span class="p strong text-uppercase text-primary line-height-loose-loose" style="display: flex ; flex-grow: 1; align-items: flex-end;">{% if project.url %}View Project{% else %}Completed{% endif %}</span>
					{% if project.url %}</a>{% else %}</div>{% endif %}
				</div>
				{% endfor %}
			</div>
			<div class="row">
				<div class="carousel-controls container">
					<div class="scroll-button scroll-left inline" data-dir="left" tabindex="-1"><i class='bx bx-chevron-left h3 text-primary' ></i></div>
					<div class="scroll-button scroll-right inline" data-dir="right" tabindex="-1"><i class='bx bx-chevron-right h3 text-primary' ></i></div>
				</div>
			</div>
		</div>
	</div>
	<!-- End: Pair List -->
</section>