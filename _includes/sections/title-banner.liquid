<style>
	.title-banner-section {
		position: relative;
		width: 100vw;
		/* padding-top: 56vw; */
		height: 56vw;
	}
	.title-banner-section input {
		position: absolute;
	}
	.title-banner-section .intro-banner-wrapper {
		position: absolute;
		top: 0;
		left: 50%;
		width: 100vw;
		/* padding-top: 56vw; */
		height: 56vw;
		transform: translateX(-50%);
		overflow: clip;
		border-radius: 0;
		transition: var(--transition-speed) var(--transition-ease);
	}
	.title-banner-section .intro-banner-wrapper .intro-banner-width {
		position: absolute;
		top: 0;
		left: 50%;
		width: 100vw;
		/* padding-top: 56vw; */
		height: 56vw;
		transform: translateX(-50%);
	}
	.title-banner-section .intro-banner-wrapper .intro-banner-width .page-title {
		display: inline-block;
		position: absolute;
		top: 50%;
		left: 50%;
		font-size: var(--h4);
		transform: translate(-50%, -50%);
		text-align: center;
		letter-spacing: calc(var(--p) * 0.05);
		line-height: 1.25;
	}
	.title-banner-section input:checked ~ .intro-banner-wrapper {
		width: var(--container-width);
		border-radius: var(--space-25);
	}
	@media( min-width: 500px ) {
		.title-banner-section ,
		.title-banner-section .intro-banner-wrapper ,
		.title-banner-section .intro-banner-wrapper .intro-banner-width {
			/* padding-top: 35vw; */
			height: 35vw;
		}
	}
	@media( min-width: 1000px ) {
		.title-banner-section ,
		.title-banner-section .intro-banner-wrapper ,
		.title-banner-section .intro-banner-wrapper .intro-banner-width {
			/* padding-top: 25vw; */
			height: 25vw;
		}
		.title-banner-section .intro-banner-wrapper .intro-banner-width .page-title {
			font-size: var(--h3);
			letter-spacing: calc(var(--p) * 0.1);
		}
	}
</style>



<section id="title-banner-section" class="title-banner-section">
	<div class="row">
		<input id="intro-image-clip" class="visuallyhidden" type="checkbox">
		<div class="intro-banner-wrapper">
			<div class="intro-banner-width fill-dark" style="position: relative; overflow: hidden;">
				{% if cover.background != blank %}
					{% image cover.background, "", "100vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; mix-blend-mode: luminosity; opacity: 0.5;" %}
				{% else %}
					{% image "/media/fallback.jpg", "", "100vw", "lazy", "", "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; mix-blend-mode: luminosity; opacity: 0.5;" %}
				{% endif %}
				<h1 class="page-title w-500 text-uppercase text-light" style="position: relative; z-index: 1;">{{ title }}</h1>
			</div>
		</div>			
	</div>
</section>



<script type="text/javascript">
document.addEventListener('DOMContentLoaded', (event) => {
	const handleScroll = () => {
		const bannerSection = document.getElementById('title-banner-section');

		if (bannerSection) {
			const imageCheckbox = document.getElementById('intro-image-clip');
			const scrollPosition = window.scrollY;
			if (scrollPosition > 0) {
			  imageCheckbox.checked = true;
			} else {
			  imageCheckbox.checked = false;
			}
		}
	};
	const debouncedScrollHandler = debounce(handleScroll, 250);
	window.addEventListener('scroll', debouncedScrollHandler);
});
</script>