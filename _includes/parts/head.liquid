<!-- City Selector -->
{% if page.url == "/" %}
<style type="text/css">
.city-selector-wrapper {
	display: none;
	position: fixed;
	z-index: 10000;
	background-color: #FFF;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	padding-top: calc(var(--card)/2.5);
	overflow-y: scroll;
}
#toggle-city-selector:checked ~ .city-selector-wrapper {
	display: block;
}
.logo-animation-box {
	position: absolute;
	top: 50%;
	left: 50%;
	width: var(--card);
	transform: translateX(-50%) translateY(-50%);
	transition: calc(var(--transition-speed)*2) var(--transition-ease);
}

.city-selector-wrapper .container {
	opacity: 0;
	pointer-events: none;
}

.city-selector-wrapper .heading {
	opacity: 0;
	transition: opacity calc(var(--transition-speed)*2) var(--transition-ease);
	transition-delay: calc(var(--transition-speed)*3);
}

.city-selector-wrapper .heading .action {
	opacity: 0;
	transition: opacity calc(var(--transition-speed)*2) var(--transition-ease);
	transition-delay: calc(var(--transition-speed)*5);
}

.city-selector-wrapper .city-selector {
	display: grid;
	gap: var(--space-100);
	grid-template-columns: 1fr;
	opacity: 0;
	transition: opacity calc(var(--transition-speed)*2) var(--transition-ease);
	transition-delay: calc(var(--transition-speed)*8);
}
.city-selector-wrapper .city-selector .card * { pointer-events: none; }
.city-selector-wrapper .city-selector .card:nth-child(2) {
	opacity: 0;
	transition: opacity calc(var(--transition-speed)*2) var(--transition-ease);
	transition-delay: calc(var(--transition-speed)*10);
}

#logo-animation-end:checked ~ .city-selector-wrapper .logo-animation-box {
	width: calc(var(--card)/2.5);
	top: 0;
	transform: translateX(-50%) translateY(0);
}

#logo-animation-end:checked ~ .city-selector-wrapper .container,
#logo-animation-end:checked ~ .city-selector-wrapper .heading,
#logo-animation-end:checked ~ .city-selector-wrapper .heading .action,
#logo-animation-end:checked ~ .city-selector-wrapper .city-selector,
#logo-animation-end:checked ~ .city-selector-wrapper .city-selector .card:nth-child(2) { opacity: 1; }
#logo-animation-end:checked ~ .city-selector-wrapper .city-selector .card { cursor: pointer }
#logo-animation-end:checked ~ .city-selector-wrapper .container{ pointer-events: auto; }

@media( min-width: 500px )  {
	.city-selector-wrapper .city-selector { grid-template-columns: 1fr 1fr; }
}
</style>
<input type="checkbox" id="toggle-city-selector" class="visuallyhidden" checked style="position: absolute; left: 0; z-index: 10001;">
<input type="checkbox" id="logo-animation-end" class="visuallyhidden" style="position: absolute; left: 20px; z-index: 10001;">
<div class="city-selector-wrapper space-50-vertical">
	<div class="logo-animation-box"><div id="lottie-container"></div></div>
	<div class="container">
		<div class="row">
			<div class="heading columns small-10 small-offset-1 text-center">
				<h2 class="h5 space-25-vertical">Celebrating 40 Years of Real Estate Opulence</h2>
				<label class="action section-label text-neutral-20 space-50-vertical">Select your City</label>
			</div>
		</div>
		<div class="row">
			<div class="city-selector columns small-12 xlarge-10 xlarge-offset-1 space-50">
				<label for="toggle-city-selector" class="block card text-center">
					<div class="title space-50">
						<span class="p block text-uppercase w-600 text-neutral-80 letter-spacing-loose">Garden City</span>
						<span class="h4 block text-uppercase w-600 text-neutral-80 letter-spacing-loose-loose">Bangalore</span>
					</div>
					<img class="block" src="https://placeholdit.com/1200x800/F1F1F1/999999" alt="">
					<div class="cta label text-uppercase w-600 text-primary letter-spacing-loose space-50">Enter</div>
				</label>
				<a href="https://google.com" target="_blank" class="block card text-center">
					<div class="title space-50">
						<span class="p block text-uppercase w-600 text-neutral-80 letter-spacing-loose">City of dreams</span>
						<span class="h4 block text-uppercase w-600 text-neutral-80 letter-spacing-loose-loose">Mumbai</span>
					</div>
					<img class="block" src="https://placeholdit.com/1200x800/F1F1F1/999999" alt="">
					<div class="cta label text-uppercase w-600 text-primary letter-spacing-loose space-50">Enter</div>
				</a>
			</div>
		</div>
	</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

	// Find the animation container
	const lottieContainer = document.getElementById('lottie-container');
	const toggleCitySelectorCheckbox = document.getElementById('toggle-city-selector');
	const logoAnimationEndCheckbox = document.getElementById('logo-animation-end');

	if (!localStorage.getItem('visit_bangalore')) {
		// Load the animation
		const anim = lottie.loadAnimation({
			container: lottieContainer,        // The div element to render into
			renderer: 'svg',                   // The renderer to use
			loop: false,                       // Set to false to play only once
			autoplay: true,                    // Set to true to play on page load
			path: 'media/logo-animation.json'       // The path to your JSON animation file
		});

		// Add an event listener for when the animation is complete
		anim.addEventListener('complete', () => {
			// You can hide the animation, show a button, or run any other function.
			console.log('Animation finished!');
			logoAnimationEndCheckbox.checked = true;

			toggleCitySelectorCheckbox.addEventListener('change', () => {
				if (!toggleCitySelectorCheckbox.checked) {
					// Save a variable to localStorage
					localStorage.setItem('visit_bangalore', true);
				}
			});
		});
	} else {
		// Based on variable in localStorage Toggle view City Selector per Session
		toggleCitySelectorCheckbox.checked = false
	}

});
</script>
{% endif %}


<!-- Project Collections -->
{% assign ongoing_projects = collections.projects | where: "data.metadata.status", "ongoing" | sort: "date" | reverse %}
{% assign ongoing_residential_projects = ongoing_projects | where: "data.metadata.type", "residential" %}
{% assign ongoing_commercial_projects = ongoing_projects | where: "data.metadata.type", "commercial" %}

{% assign completed_projects = collections.projects | where: "data.metadata.status", "completed" | sort: "date" | reverse %}
{% assign completed_residential_projects = completed_projects | where: "data.metadata.type", "residential" %}
{% assign completed_commercial_projects = completed_projects | where: "data.metadata.type", "commercial" %}

