<!-- Menu Toggle -->
<input type="checkbox" id="menu-toggle-checkbox" class="hidden" style="top: 0;" />

<!-- Header Section -->
<header id="header-section" class="header-section fill-light">
	<div class="row text-center">
		<a class="logo" href="/" aria-label="Home Page"><img loading="lazy" class="logo-image block" src="media/logo-color.svg" alt=""></a>
	</div>
</header>
<!-- End: Header Section -->

<!-- The clickable label for the checkbox -->
<label for="menu-toggle-checkbox" class="menu-toggle" aria-label="Toggle Main Menu">
	<span class="icon-bar"></span>
	<span class="icon-bar"></span>
	<span class="icon-bar"></span>
</label>


<!-- Main Nav -->
<nav id="main-nav" class="main-nav" role="navigation" aria-labelledby="main-nav-heading">
	<h2 id="main-nav-heading" class="w-200 space-150-right">Menu</h2>
	<ul class="menu-list space-25-top">
		<li><a href="">Home</a></li>
		<li>
			<input type="checkbox" id="residential-submenu-checkbox" class="submenu-checkbox hidden">
			<label for="residential-submenu-checkbox" class="submenu-label">Residential</label>
			<ul id="residential-submenu" class="sub-menu space-75-right">
				<li>
					<input type="checkbox" id="residential-ongoing-submenu-checkbox" class="submenu-checkbox hidden">
					<label for="residential-ongoing-submenu-checkbox" class="submenu-label">Ongoing Projects</label>
					<ul id="residential-submenu" class="sub-menu space-75-right">
						{% for project in ongoing_residential_projects %}
						<li><a class="" href="{{ project.url }}">{% if project.data.metadata.prefix-name == true %}Vaswani {% endif %}{{ project.data.name }}</a></li>
						{% endfor %}
					</ul>
				</li>
				<li>
					<input type="checkbox" id="residential-completed-submenu-checkbox" class="submenu-checkbox hidden">
					<label for="residential-completed-submenu-checkbox" class="submenu-label">Completed Projects</label>
					<ul id="residential-submenu" class="sub-menu space-75-right">
						{% for project in completed_residential_projects %}
						<li><a class="" href="{{ project.url }}">{% if project.data.metadata.prefix-name == true %}Vaswani {% endif %}{{ project.data.name }}</a></li>
						{% endfor %}
					</ul>
				</li>
			</ul>
		</li>
		<li>
			<input type="checkbox" id="commercial-submenu-checkbox" class="submenu-checkbox hidden">
			<label for="commercial-submenu-checkbox" class="submenu-label">Commercial</label>
			<ul id="commercial-submenu" class="sub-menu space-75-right">
				<li>
					<input type="checkbox" id="commercial-ongoing-submenu-checkbox" class="submenu-checkbox hidden">
					<label for="commercial-ongoing-submenu-checkbox" class="submenu-label">Ongoing Projects</label>
					<ul id="commercial-submenu" class="sub-menu space-75-right">
						{% for project in ongoing_commercial_projects %}
						<li><a class="" href="{{ project.url }}">{% if project.data.metadata.prefix-name == true %}Vaswani {% endif %}{{ project.data.name }}</a></li>
						{% endfor %}
					</ul>
				</li>
				<li>
					<input type="checkbox" id="commercial-completed-submenu-checkbox" class="submenu-checkbox hidden">
					<label for="commercial-completed-submenu-checkbox" class="submenu-label">Completed Projects</label>
					<ul id="commercial-submenu" class="sub-menu space-75-right">
						{% for project in completed_commercial_projects %}
						<li><a class="" href="{{ project.url }}">{% if project.data.metadata.prefix-name == true %}Vaswani {% endif %}{{ project.data.name }}</a></li>
						{% endfor %}
					</ul>
				</li>
			</ul>
		</li>
		{% for link in menu.link %}
			<li><a href="{{ link.path }}">{{ link.title }}</a></li>
		{% endfor %}
	</ul>
</nav>
<!-- End: Main Nav -->



<!-- Main -->
<main class="main-content" role="main">